{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "composite": true,
    "noEmit": true
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/core/**/*", "src/shared/**/*", "src/cli/**/*", "tests/**/*", "scripts/**/*", "e2e/**/*", "electron.vite.config.mts", "vitest.config.mts", "playwright.config.ts"]
}
