{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@core/*": [
        "./src/core/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@renderer/*": [
        "./src/renderer/src/*"
      ]
    }
  },
  "include": [
    "src/browser/**/*",
    "src/core/**/*",
    "src/preload/*.d.ts",
    "src/renderer/**/*",
    "src/shared/**/*",
    "tests/core/offline-translator.test.ts",
    "tests/browser-ordered-player.test.ts", "tests/accelerator.test.ts"
  ]
}
