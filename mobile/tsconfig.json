{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "paths": { "@core/*": ["../src/core/*"] }
  },
  "include": ["src/**/*", "../src/browser/**/*", "../src/core/**/*", "../e2e/mobile.spec.ts", "../e2e/mac-audio-diag.spec.ts", "../e2e/helpers.ts"]
}
